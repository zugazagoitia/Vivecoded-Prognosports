{
  "name": "prognosports-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "10.34.6",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "e2e": "pnpm build && playwright test",
    "e2e:ci": "playwright test",
    "e2e:ui": "pnpm build && playwright test --ui",
    "e2e:update": "pnpm build && playwright test visual --update-snapshots=all",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p e2e/tsconfig.json",
    "lint:ox": "oxlint",
    "lint:eslint": "eslint .",
    "lint": "pnpm lint:ox && pnpm lint:eslint",
    "lint:fix": "oxlint --fix && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "api:types": "openapi-typescript api/openapi.json -o src/api/schema.d.ts",
    "api:types:fetch": "curl -fsSL https://api.prognosports.com/openapi -o api/openapi.json && pnpm api:types"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.104.1",
    "@vueuse/core": "^15.0.0",
    "date-fns": "^4.4.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tanstack/vue-query-devtools": "^6.3.1",
    "@testing-library/user-event": "^14.6.7",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.87.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.2",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.2",
    "lefthook": "^2.2.1",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13",
    "web-vitals": "^6.2.3"
  }
}
