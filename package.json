{
  "name": "prognosports-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "10.34.6",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "api:types": "openapi-typescript api/openapi.json -o src/api/schema.d.ts",
    "api:types:fetch": "curl -fsSL https://api.prognosports.com/openapi -o api/openapi.json && pnpm api:types"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.104.1",
    "@vueuse/core": "^15.0.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
