# Producción (`master`): API de producción y los 12 feature flags activados (docs/feature-flags.md).
# Solo configuración pública: nada de secretos en VITE_* (acaban en el bundle).
VITE_API_BASE_URL=https://api.prognosports.com
VITE_FF_MY_SEASON=true
VITE_FF_HONOURS=true
VITE_FF_GAP=true
VITE_FF_BUMP=true
VITE_FF_TITLE_RACE=true
VITE_FF_CONSISTENCY=true
VITE_FF_HEAD_TO_HEAD=true
VITE_FF_DISTRIBUTION=true
VITE_FF_HEATMAP=true
VITE_FF_HITS_BY_TYPE=true
VITE_FF_POINTS_BY_SESSION=true
VITE_FF_COMMUNITY_PERCENTILE=true

# Fotos de pilotos (media.formula1.com): licencia sin confirmar, apagado a propósito (docs/feature-flags.md).
VITE_FF_PUBLIC_HEADSHOTS=true

# Medios de F1 (issue #223): apagados a propósito hasta que el propietario los revise en beta.
VITE_FF_F1_TRACK_ICONS=false
VITE_FF_F1_TEAM_LOGOS=false
